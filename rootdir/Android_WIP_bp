LOCAL_MODULE_PATH  := $(TARGET_ROOT_OUT)
include $(BUILD_PREBUILT)
prebuilt_etc {
    name: "init.recovery.qcom.rc",
    src: "etc/init.qcom.power.rc",
    sub_dir: "init/hw",
    vendor: true,
}

include $(CLEAR_VARS)
LOCAL_MODULE       := ueventd.qcom.rc

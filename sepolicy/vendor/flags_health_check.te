
allow flags_health_check aac_drc_prop:file open;
allow flags_health_check keystore_config_prop:file { getattr open };
allow flags_health_check bootanim_config_prop:file { getattr open };
allow flags_health_check bootanim_system_prop:file { getattr open };
allow flags_health_check bootloader_boot_reason_prop:file { open };
allow flags_health_check ctl_bootanim_prop:file { open getattr };
allow flags_health_check vendor_file:file { read getattr };

dontaudit {
  flags_health_check
} property_type:file r_file_perms;

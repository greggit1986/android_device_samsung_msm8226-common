binder_call(system_app, wificond)

allow system_app proc_pagetypeinfo:file r_file_perms;
allow system_app sysfs_mdnie:dir search;
allow system_app sysfs_mdnie:file rw_file_perms;
allow system_app proc_pagetypeinfo:file r_file_perms;
allow system_app sysfs_zram:dir search;
allow system_app sysfs_zram:file r_file_perms;
allow system_app hal_light_default:binder call;

allow system_app hal_power_default:binder call;
allow system_app hal_wifi_supplicant_default:binder call;
allow system_app hal_wifi_default:binder call;

dontaudit system_app {
  apex_service
  system_suspend_control_service
}:service_manager find;

allow system_app artd:binder call;
allow system_app hal_lineage_health_default:binder call;
allow system_app vendor_file:file { getattr read execute open };

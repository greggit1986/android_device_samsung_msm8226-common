
allow mediaprovider_app media_rw_data_file:lnk_file setattr;
allow mediaprovider_app sdcardfs:lnk_file getattr;
allow mediaprovider_app vendor_file:file { getattr read open execute };
allow mediaprovider_app rootfs:dir { add_name create read write remove_name };
allow mediaprovider_app rootfs:dir { open setattr };
allow mediaprovider_app rootfs:file { getattr create open read rename setattr write append lock unlink };

